    {
      "id": "rcaeval-cpu-saturation",
      "title": "RCAEval · CPU 资源饱和",
      "description": "依据 RCAEval RE1/RE2 的 CPU 故障类型，在本地结账服务复现持续高 CPU 压力所表现出的高延迟。",
      "benchmark": "RCAEval RE2",
      "fault_class": "cpu",
      "source_case_pattern": "re2-ob/{service}_cpu_{instance}",
      "source_url": "https://github.com/phamquiluan/RCAEval/tree/4695aa69f4f1f57b9094ca04ff235908b73a8e24",
      "source_commit": "4695aa69f4f1f57b9094ca04ff235908b73a8e24",
      "license": "MIT",
      "data_origin": "replay_external",
      "simulation_profile": "cpu_saturation",
      "target_service": "checkoutservice",
      "resource": "cpu",
      "expected_alerts": ["FaultLabHighP95Latency", "FaultLabResourcePressure"],
      "expected_evidence": ["fault_lab_resource_pressure{resource=\"cpu\"} >= 95", "P95 latency > 2s", "checkoutservice CPU saturation"],
      "ground_truth": "checkoutservice CPU 资源饱和导致请求处理延迟",
      "runbook": "high-latency.md",
      "safe": true
    },
    {
